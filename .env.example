# VOWS Studio — Canonical Environment Variables (.env.example)
# Scope: See GLOSSARY_AND_ENUMS.md §9

# Public variables (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_MODE=production
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key

# Server-only variables
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
APP_MODE=production
ALLOWED_SUPABASE_PROJECT_REF=your-project-ref
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_TOKEN_ENCRYPTION_KEY=64-character-hex-aes-256-gcm-key
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key
CRON_SECRET=your-vercel-cron-secret
