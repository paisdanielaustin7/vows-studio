# ==============================================================================
# VOWS STUDIO OS — ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Supabase Cloud Database (Required for Cloud Sync & Realtime)
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Resend API for Emailing Quotations with PDF (Optional)
# Get a free API key at: https://resend.com
RESEND_API_KEY=re_your_api_key_here

# 3. Google Form Webhook Security (Optional)
GOOGLE_FORM_WEBHOOK_SECRET=vows_intake_secret_2026

# 4. Google Drive Automated Client Archival (Optional)
# Service account credentials from Google Cloud Console
GOOGLE_DRIVE_CLIENT_EMAIL=vows-storage@your-gcp-project.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_google_drive_folder_id_here
